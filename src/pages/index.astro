---
/**
 * Loom 首页 —— 门户入口
 *
 * 结构：三入口（看板 / 资源 / 工具）+ 各项概览 + 最新动态。
 * 加内容不需要改这个文件：看板读 assets manifest 统计，资源读 assets，工具读 TOOLS 常量。
 */
import { Icon } from "astro-icon/components";
import { assets, assetsLatest, countByKind } from "../components/loom/assets";
import { siteConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

const kinds = countByKind();

/** 工具清单 —— 与 /tools/ 页保持一致（那边是权威，这里只取数量与首项做预览） */
const TOOLS = [
	{ name: "选品工具 · PageHarvest", status: "可用" },
	{ name: "达人采集 · MediaCrawler", status: "本机" },
];

const recentAssets = assets.slice(0, 3);
const hasAny = assets.length > 0 || TOOLS.length > 0;
---

<MainGridLayout description={`${siteConfig.title} —— ${siteConfig.subtitle}`}>
	<div class="loom-board">
		<header class="loom-masthead">
			<p class="loom-eyebrow">Personal Data Loom</p>
			<h1>把散落的数据<br />织成一匹布</h1>
			<p>{siteConfig.subtitle} · 看板看结论，资源取存货，工具直接用</p>
			<div class="loom-stamp">
				<span><b>{assets.length}</b> 份资源</span>
				<span><b>{TOOLS.length}</b> 个工具</span>
				{assetsLatest && <span>资源更新至 <b>{assetsLatest}</b></span>}
			</div>
		</header>

		{/* 三入口 —— 首页第一屏就要能分出「去哪」 */}
		<nav class="loom-gate" aria-label="主入口">
			<a class="loom-gate-card" href={url("/dashboards/")}>
				<Icon name="material-symbols:space-dashboard-rounded" class="loom-gate-icon" aria-hidden="true" />
				<span class="loom-gate-title">看板</span>
				<span class="loom-gate-desc">
					{assets.length > 0
						? `${assets.length} 份资源 · ${kinds.gallery} 图集 / ${kinds.dataset} 数据集`
						: "采集了什么、有多少"}
				</span>
				<Icon name="material-symbols:arrow-forward-rounded" class="loom-gate-arrow" aria-hidden="true" />
			</a>

			<a class="loom-gate-card" href={url("/resources/")}>
				<Icon name="material-symbols:dataset-rounded" class="loom-gate-icon" aria-hidden="true" />
				<span class="loom-gate-title">资源</span>
				<span class="loom-gate-desc">数据集与图集 · 站内预览 · 评论索取</span>
				<Icon name="material-symbols:arrow-forward-rounded" class="loom-gate-arrow" aria-hidden="true" />
			</a>

			<a class="loom-gate-card" href={url("/tools/")}>
				<Icon name="material-symbols:construction-rounded" class="loom-gate-icon" aria-hidden="true" />
				<span class="loom-gate-title">工具</span>
				<span class="loom-gate-desc">{TOOLS.length} 个可直接用的小工具</span>
				<Icon name="material-symbols:arrow-forward-rounded" class="loom-gate-arrow" aria-hidden="true" />
			</a>
		</nav>

		{!hasAny && (
			<div class="loom-empty">
				<p class="loom-empty-title">框架已就绪，等内容填充</p>
				<p class="loom-empty-note">
					往 <code>site/assets/manifest.json</code> 加资源、
					往 <code>site/src/pages/tools.astro</code> 加工具，这里自动出现。
				</p>
			</div>
		)}

		{recentAssets.length > 0 && (
			<section class="loom-section">
				<h2 class="loom-section-title">
					最近资源
					<a class="loom-section-more" href={url("/resources/")}>
						全部
						<Icon name="material-symbols:chevron-right-rounded" class="loom-more-icon" aria-hidden="true" />
					</a>
				</h2>
				<div class="loom-recent">
					{recentAssets.map((a) => (
						<a class="loom-recent-row" href={url(`/resources/${a.id}/`)}>
							<span class="loom-recent-title">{a.title}</span>
							<span class="loom-recent-meta">{a.scale}</span>
						</a>
					))}
				</div>
			</section>
		)}

		<footer class="loom-footer">
			<p class="loom-footer-note">
				T+1 静态快照 · 构建时读数据 · 运行时零请求<br />
				原档保存在本地，站上只放预览
			</p>
		</footer>
	</div>
</MainGridLayout>

<style>
	.loom-gate {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin: 1.75rem 0 2rem;
	}

	.loom-gate-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.35rem 1.35rem 1.5rem;
		border: 1px solid var(--loom-line);
		border-radius: var(--r-md);
		background: var(--loom-card);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.18s, transform 0.18s;
	}

	.loom-gate-card:hover {
		border-color: var(--loom-accent);
		transform: translateY(-2px);
	}

	/* SVG 图标不响应 font-size，必须显式宽高（astro-icon 渲染成 <svg>） */
	.loom-gate-icon {
		width: 20px;
		height: 20px;
		color: var(--loom-accent);
		flex-shrink: 0;
	}

	.loom-gate-title {
		font-size: 1.15rem;
		font-weight: var(--fw-semibold);
	}

	.loom-gate-desc {
		font-size: 0.83rem;
		color: var(--loom-muted);
		line-height: 1.6;
	}

	.loom-gate-arrow {
		position: absolute;
		right: 1.35rem;
		bottom: 1.2rem;
		width: 18px;
		height: 18px;
		color: var(--loom-muted);
		transition: color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}

	.loom-gate-card:hover .loom-gate-arrow {
		color: var(--loom-accent);
		transform: translateX(3px);
	}

	.loom-section-more {
		float: right;
		display: inline-flex;
		align-items: center;
		gap: var(--sp-1);
		font-size: 0.78rem;
		font-weight: 400;
		color: var(--loom-muted);
		text-decoration: none;
	}

	.loom-section-more:hover {
		color: var(--loom-accent);
	}

	.loom-more-icon {
		width: 14px;
		height: 14px;
	}

	.loom-recent {
		display: flex;
		flex-direction: column;
	}

	.loom-recent-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.65rem 0.25rem;
		border-bottom: 1px solid var(--loom-line);
		text-decoration: none;
		color: inherit;
		font-size: 0.88rem;
	}

	.loom-recent-row:hover {
		color: var(--loom-accent);
	}

	.loom-recent-meta {
		color: var(--loom-muted);
		font-size: 0.8rem;
		font-family: var(--font-mono);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.loom-empty {
		padding: 3rem 1.5rem;
		text-align: center;
		border: 1px dashed var(--loom-line);
		border-radius: var(--r-md);
		margin-bottom: 1.5rem;
	}

	.loom-empty-title {
		margin: 0 0 0.4rem;
		font-weight: 600;
	}

	.loom-empty-note {
		margin: 0;
		color: var(--loom-muted);
		font-size: 0.88rem;
		line-height: 1.7;
	}

	.loom-empty-note code {
		padding: 0.1rem 0.35rem;
		border-radius: var(--r-sm);
		background: var(--loom-line);
		font-size: 0.85em;
	}
</style>